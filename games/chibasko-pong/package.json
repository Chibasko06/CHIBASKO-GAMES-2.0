{
  "name": "@chibaskogames/chibasko-pong",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "files": ["dist", "README.md", "CHANGELOG.md"],
  "sideEffects": ["**/*.css"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./client": { "types": "./dist/client/index.d.ts", "default": "./dist/client/index.js" },
    "./local": { "types": "./dist/local/index.d.ts", "default": "./dist/local/index.js" },
    "./server": { "types": "./dist/server/index.d.ts", "default": "./dist/server/index.js" },
    "./shared": { "types": "./dist/shared/simulation.d.ts", "default": "./dist/shared/simulation.js" }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:client": "node scripts/build.mjs client",
    "build:server": "node scripts/build.mjs server",
    "build:shared": "node scripts/build.mjs shared",
    "typecheck": "node scripts/build.mjs --check",
    "prepare": "npm run build",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "test:shared": "npm run build:shared && node --test tests/engine.test.mjs",
    "test:server": "npm run build:server && node scripts/build.mjs runtime && node --test tests/driver-parity.test.mjs",
    "test:client": "npm run build:client && node --import ./tests/css-loader.mjs --test tests/host.test.mjs",
    "pretest": "npm run build",
    "test": "npm run check:boundaries && node --import ./tests/css-loader.mjs --test tests/*.test.mjs"
  },
  "dependencies": { "@colyseus/schema": "5.0.36" },
  "peerDependencies": { "@chibaskogames/sdk": "0.1.0", "react": "^19.0.0" },
  "peerDependenciesMeta": { "react": { "optional": true } },
  "devDependencies": {
    "@chibaskogames/sdk": "git+https://github.com/Chibasko06/chibasko-games-sdk.git#v0.1.0",
    "@types/react": "^19.0.0", "@types/react-dom": "^19.0.0",
    "jsdom": "29.1.1", "react": "19.2.4", "react-dom": "19.2.4", "typescript": "5.9.3"
  }
}
