{
  "name": "chibaskogames-v2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "generate:distribution-schema": "node scripts/generate-distribution-validator.mjs",
    "check:distribution-schema": "node scripts/generate-distribution-validator.mjs --check",
    "test:game-distribution": "npm run check:distribution-schema && node --import ./tests/register.mjs --test tests/game-distribution.test.mjs",
    "test:game-distribution-db": "node tests/game-distribution-db.mjs",
    "build:distribution": "node scripts/build-distribution.mjs",
    "test:game-uploads": "npm run build:distribution && node --import ./tests/register.mjs --test tests/game-upload.test.mjs",
    "test:game-uploads-db": "node tests/game-distribution-db.mjs --uploads",
    "test:game-artifacts": "node --import ./tests/register.mjs --test tests/game-artifact-gateway.test.mjs",
    "test:game-artifacts-db": "node tests/game-distribution-db.mjs --previews",
    "test:game-runtime": "node --import ./tests/register.mjs --test tests/game-runtime.test.mjs tests/game-runtime-compat.test.mjs",
    "test:game-runtime-browser": "node --import ./tests/register.mjs --test tests/game-runtime.browser.test.mjs",
    "test:game-runtime-db": "node tests/game-distribution-db.mjs --launches",
    "dev": "next dev",
    "predev": "npm run build:sdk && npm run build:pong",
    "build": "npm run build:sdk && npm run build:pong && npm run check:game-boundaries && next build",
    "build:sdk": "node scripts/build-game-sdk.mjs",
    "check:game-boundaries": "node scripts/check-game-boundaries.mjs",
    "test:sdk": "npm run build:sdk && node --import ./tests/register.mjs --test tests/game-sdk.test.mjs",
    "test:sdk-extraction": "node scripts/test-sdk-extraction.mjs",
    "test:sdk-platform": "node scripts/test-sdk-platform.mjs",
    "pretest": "npm run build:sdk && npm run build:pong && npm run check:distribution-schema",
    "pregenerate:game-manifest": "npm run build:sdk && npm run build:pong",
    "precheck:game-manifest": "npm run build:sdk && npm run build:pong",
    "start": "next start",
    "lint": "eslint",
    "test": "node --import ./tests/register.mjs --test tests/security.test.mjs tests/cloudflare.test.mjs tests/r2-thumbnails.test.mjs tests/r2-avatars.test.mjs tests/playground-connection.test.mjs tests/lobby-connection.test.mjs tests/lobby-game-session.test.mjs tests/game-catalogue.test.mjs tests/product-session.test.mjs tests/game-sdk.test.mjs tests/game-distribution.test.mjs && npm run test:game-uploads && npm run test:game-artifacts && npm run test:game-runtime && npm run test:online-session && npm run test:product && npm run test:admin",
    "test:db": "node tests/database-security.mjs",
    "build:cloudflare": "node scripts/cloudflare.mjs build",
    "preview:cloudflare": "npm run build:cloudflare && node scripts/cloudflare.mjs preview",
    "deploy:cloudflare": "npm run build:cloudflare && node scripts/cloudflare.mjs deploy",
    "generate:game-manifest": "node scripts/generate-game-manifest.mjs",
    "check:game-manifest": "node scripts/generate-game-manifest.mjs --check",
    "test:catalogue-db": "node tests/game-catalogue-db.mjs",
    "test:product": "node --import ./tests/product-register.mjs --test tests/multiplayer-product.test.mjs tests/pong-local-product.test.mjs && node --import ./tests/admin-ui-register.mjs --test tests/admin-ui.test.mjs",
    "test:admin": "node --import ./tests/admin-register.mjs --test tests/admin-security.test.mjs",
    "test:admin-db": "node tests/admin-db.mjs",
    "test:pong-local": "npm run build:sdk && npm run build:pong && node --import ./tests/product-register.mjs --test tests/pong-local-product.test.mjs",
    "build:pong": "node scripts/build-pong.mjs",
    "test:pong": "npm run test:pong-local",
    "test:pong-extraction": "npm run build:sdk && npm run build:pong && node scripts/test-pong-extraction.mjs",
    "test:pong-platform": "node scripts/test-pong-platform.mjs",
    "pretest:product": "npm run build:sdk && npm run build:pong",
    "test:online-session": "node --import ./tests/register.mjs --test tests/online-session.test.mjs",
    "test:online-session-db": "node tests/game-distribution-db.mjs --online",
    "test:online-session-browser": "node --test tests/online-session.browser.test.mjs",
    "test:multiplayer": "node --import ./tests/register.mjs --test tests/multiplayer-lobbies.test.mjs",
    "test:multiplayer-db": "node tests/game-distribution-db.mjs --multiplayer"
  },
  "dependencies": {
    "@chibaskogames/chibasko-pong": "git+https://github.com/Chibasko06/Chibasko-Pong.git#v0.1.0",
    "@chibaskogames/sdk": "0.3.0",
    "@colyseus/sdk": "0.18.5",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "^2.104.0",
    "@xmldom/xmldom": "0.9.12",
    "@zip.js/zip.js": "2.23.0",
    "aws4fetch": "1.0.20",
    "image-size": "2.0.4",
    "next": "16.3.8",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.12.2",
    "server-only": "0.0.1",
    "tldts": "7.4.18"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.9",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "ajv": "8.20.0",
    "esbuild": "0.25.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "4.148.0"
  },
  "overrides": {
    "@chibaskogames/chibasko-pong": {
      "@chibaskogames/sdk": "$@chibaskogames/sdk"
    }
  }
}
