{
  "name": "chibaskogames-v2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test:developer-submissions": "node --import ./tests/register.mjs --test tests/developer-submissions.test.mjs tests/submission-catalogue.test.mjs tests/submission-feedback.test.mjs tests/submission-drafts.test.mjs && node --import ./tests/product-register.mjs --test tests/developer-submissions-ui.test.mjs",
    "test:developer-submissions-browser": "node --test tests/submission-browser.test.mjs",
    "test:developer-submissions-db": "node tests/game-distribution-db.mjs --uploads --reviews --submissions",
    "review:game": "node scripts/review-game.mjs",
    "test:build-reviews": "node --import ./tests/admin-register.mjs --test tests/build-review.test.mjs tests/admin-security.test.mjs tests/review-game-config.test.mjs",
    "test:build-review-ui": "node --import ./tests/register.mjs --test tests/admin-review-presentation.test.mjs && node --import ./tests/admin-ui-register.mjs --test tests/admin-ui.test.mjs",
    "test:build-review-browser": "node --test tests/admin-build-review.browser.test.mjs",
    "test:build-reviews-db": "node tests/game-distribution-db.mjs --uploads --reviews",
    "generate:distribution-schema": "node scripts/generate-distribution-validator.mjs",
    "check:distribution-schema": "node scripts/generate-distribution-validator.mjs --check",
    "test:game-distribution": "npm run check:distribution-schema && node --import ./tests/register.mjs --test tests/game-distribution.test.mjs",
    "test:game-distribution-db": "node tests/game-distribution-db.mjs",
    "build:distribution": "node scripts/build-distribution.mjs",
    "build:validator": "node scripts/build-validator.mjs",
    "test:validator": "npm run build:validator && node --import ./tests/register.mjs --test tests/build-validator-runtime.test.mjs tests/game-upload.test.mjs",
    "test:game-uploads": "npm run build:distribution && node --import ./tests/register.mjs --test tests/game-upload.test.mjs tests/upload-diagnostics.test.mjs tests/r2-native.test.mjs tests/build-dispatcher.test.mjs",
    "test:r2-worker": "node --test tests/r2-worker.test.mjs",
    "test:game-uploads-db": "node tests/game-distribution-db.mjs --uploads",
    "test:game-artifacts": "node --import ./tests/register.mjs --test tests/game-artifact-gateway.test.mjs",
    "test:game-artifacts-db": "node tests/game-distribution-db.mjs --previews",
    "test:game-runtime": "node --import ./tests/register.mjs --test tests/game-runtime.test.mjs tests/game-runtime-compat.test.mjs tests/game-launch-diagnostics.test.mjs",
    "test:game-runtime-browser": "node --import ./tests/register.mjs --test tests/game-runtime.browser.test.mjs",
    "test:game-runtime-db": "node tests/game-distribution-db.mjs --launches",
    "dev": "next dev",
    "predev": "npm run build:sdk",
    "build": "npm run build:sdk && npm run check:game-boundaries && next build",
    "build:sdk": "node scripts/build-game-sdk.mjs",
    "check:game-boundaries": "node scripts/check-game-boundaries.mjs",
    "test:sdk": "npm run build:sdk && node --import ./tests/register.mjs --test tests/game-sdk.test.mjs",
    "pretest": "npm run build:sdk && npm run check:distribution-schema",
    "start": "next start",
    "lint": "eslint",
    "test": "node --import ./tests/register.mjs --test tests/security.test.mjs tests/cloudflare.test.mjs tests/r2-thumbnails.test.mjs tests/r2-avatars.test.mjs tests/game-catalogue.test.mjs tests/game-sdk.test.mjs tests/game-distribution.test.mjs && npm run test:game-uploads && npm run test:game-artifacts && npm run test:game-runtime && npm run test:online-session && npm run test:multiplayer && npm run test:product && npm run test:admin && npm run test:go-live",
    "test:go-live": "node --test tests/production-preflight.test.mjs tests/go-live-gates.test.mjs tests/source-map-security.test.mjs && node --import ./tests/register.mjs --test tests/session-maintenance.test.mjs",
    "test:go-live-db": "node tests/production-schema-reference.mjs",
    "test:db": "node tests/database-security.mjs",
    "build:cloudflare": "node scripts/cloudflare.mjs build",
    "preview:cloudflare": "npm run build:cloudflare && node scripts/cloudflare.mjs preview",
    "deploy:cloudflare": "npm run build:cloudflare && node scripts/cloudflare.mjs deploy",
    "test:catalogue-db": "node tests/game-catalogue-db.mjs",
    "test:product": "node --import ./tests/product-register.mjs --test tests/artifact-product.test.mjs && node --import ./tests/admin-ui-register.mjs --test tests/admin-ui.test.mjs",
    "test:admin": "node --import ./tests/admin-register.mjs --test tests/admin-security.test.mjs",
    "test:admin-db": "node tests/admin-db.mjs",
    "pretest:product": "npm run build:sdk",
    "test:online-session": "node --import ./tests/register.mjs --test tests/online-session.test.mjs",
    "test:online-session-db": "node tests/game-distribution-db.mjs --online",
    "test:online-session-browser": "node --test tests/online-session.browser.test.mjs",
    "test:multiplayer": "node --import ./tests/register.mjs --test tests/multiplayer-lobbies.test.mjs tests/game-server-session.test.mjs",
    "test:multiplayer-db": "node tests/game-distribution-db.mjs --multiplayer",
    "test:pong-e2e": "node tests/game-distribution-db.mjs --pong"
  },
  "dependencies": {
    "@chibaskogames/sdk": "0.3.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "^2.104.0",
    "@xmldom/xmldom": "0.9.12",
    "@zip.js/zip.js": "2.23.0",
    "aws4fetch": "1.0.20",
    "image-size": "2.0.4",
    "next": "16.3.8",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "6.12.4",
    "server-only": "0.0.1",
    "tldts": "7.4.18"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.9",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "ajv": "8.20.0",
    "esbuild": "0.25.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "4.148.0"
  }
}
