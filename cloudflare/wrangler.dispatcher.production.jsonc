{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "chibasko-build-dispatcher",
  "main": "build-dispatcher.ts",
  "compatibility_date": "2026-10-16",
  "workers_dev": false,
  "preview_urls": false,
  "keep_vars": true,
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    "SUPABASE_URL": "https://oakjtjrzqkoiajmzbdlc.supabase.co",
    "GAME_BUILD_DISPATCHER_ENABLED": "0"
  },
  "queues": {
    "producers": [{ "binding": "BUILD_VALIDATIONS", "queue": "chibasko-game-builds" }]
  },
  "observability": {
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": false }
  }
}
