{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "chibasko-session-maintenance",
  "main": "../.distribution/session-maintenance.mjs",
  "compatibility_date": "2026-10-18",
  "workers_dev": false,
  "preview_urls": false,
  "keep_vars": true,
  "build": { "command": "npm run build:maintenance" },
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": {
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": false }
  },
  "vars": {
    "SUPABASE_URL": "https://oakjtjrzqkoiajmzbdlc.supabase.co",
    "RESEND_FROM_EMAIL": "noreply@chibaskogames.fr",
    "GAME_SUBMISSION_NOTIFY_EMAIL": "chibasko06@gmail.com",
    "NEXT_PUBLIC_SITE_URL": "https://chibaskogames.fr",
    "GAME_SESSION_MAINTENANCE_ENABLED": "1",
    "GAME_UPLOAD_MAINTENANCE_ENABLED": "1",
    "GAME_SUBMISSION_NOTIFICATIONS_ENABLED": "1",
    "CONTACT_RECEIPTS_MAINTENANCE_ENABLED": "1",
    "GAME_ACCOUNT_DELETIONS_ENABLED": "1"
  },
  "r2_buckets": [
    { "binding": "CHIBASKO_ASSETS", "bucket_name": "chibasko-assets" },
    { "binding": "GAME_BUILDS_STAGING", "bucket_name": "chibasko-game-staging" },
    { "binding": "GAME_BUILDS_ARTIFACTS", "bucket_name": "chibasko-game-artifacts" }
  ]
}
