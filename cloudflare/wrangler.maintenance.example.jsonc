// Modèle inactif : sa compilation n'installe ni route, ni ressource, ni cron.
{
  "name": "chibasko-session-maintenance-example",
  "main": "../.distribution/session-maintenance.mjs",
  "compatibility_date": "2026-10-18",
  "workers_dev": false,
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "logs": { "enabled": true, "invocation_logs": false } },
  "vars": { "GAME_UPLOAD_MAINTENANCE_ENABLED": "0", "CONTACT_RECEIPTS_MAINTENANCE_ENABLED": "0", "GAME_SESSION_MAINTENANCE_ENABLED": "0", "GAME_SUBMISSION_NOTIFICATIONS_ENABLED": "0", "GAME_ACCOUNT_DELETIONS_ENABLED": "0" },
  "r2_buckets": [
    { "binding": "CHIBASKO_ASSETS", "bucket_name": "chibasko-assets" },
    { "binding": "GAME_BUILDS_STAGING", "bucket_name": "chibasko-game-staging" },
    { "binding": "GAME_BUILDS_ARTIFACTS", "bucket_name": "chibasko-game-artifacts" }
  ]
}
