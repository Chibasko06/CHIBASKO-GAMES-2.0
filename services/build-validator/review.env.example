# Copier vers .env.review.local à la racine du dépôt, puis renseigner localement.
# Aucun token Queue n’est nécessaire pour review:game.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GAME_BUILDS_R2_ACCOUNT_ID=
GAME_BUILDS_R2_ACCESS_KEY_ID=
GAME_BUILDS_R2_SECRET_ACCESS_KEY=
GAME_BUILDS_STAGING_BUCKET=chibasko-game-staging
GAME_BUILDS_ARTIFACTS_BUCKET=chibasko-game-artifacts
# Facultatif : répertoire temporaire sur un disque disposant de 24–32 Gio libres.
