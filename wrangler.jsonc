{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "chibasko-games-preview",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-07",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "keep_vars": true,
  "routes": [
    {
      "pattern": "chibaskogames.fr",
      "custom_domain": true
    },
    {
      "pattern": "www.chibaskogames.fr",
      "custom_domain": true
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issues": {
      "enabled": false
    }
  },
  "r2_buckets": [
    {
      "binding": "CHIBASKO_ASSETS",
      "bucket_name": "chibasko-assets"
    },
    {
      "binding": "GAME_BUILDS_STAGING",
      "bucket_name": "chibasko-game-staging"
    },
    {
      "binding": "GAME_BUILDS_ARTIFACTS",
      "bucket_name": "chibasko-game-artifacts"
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "CHIBASKO_CLOUDFLARE": "1",
    "CONTACT_FORM_ENABLED": "1",
    "CONTACT_NOTIFY_EMAIL": "chibasko06@gmail.com",
    "GAME_DISTRIBUTION_UPLOADS_ENABLED": "1",
    "GAME_ARTIFACT_PREVIEWS_ENABLED": "1",
    "GAME_SUBMISSION_NOTIFICATIONS_ENABLED": "1",
    "GAME_SUBMISSION_NOTIFY_EMAIL": "chibasko06@gmail.com",
    "GAME_ACCOUNT_DELETIONS_ENABLED": "1",
    "GAME_BUILDS_R2_ACCOUNT_ID": "fba4f99126d01d7ba269728af9af25ff",
    "GAME_BUILDS_STAGING_BUCKET": "chibasko-game-staging",
    "GAME_BUILDS_ARTIFACTS_BUCKET": "chibasko-game-artifacts",
    "GAME_RUNTIME_LAUNCHES_ENABLED": "1",
    "GAME_CONTENT_BASE_DOMAIN": "chibaskogames-play.fr",
    "GAME_CONTENT_PUBLIC_BASE": "chibaskogames-play.fr",
    "GAME_CONTENT_PREVIEW_BASE": "chibaskogames-play.fr",
    "GAME_PORTAL_ORIGINS": "https://chibaskogames.fr,https://www.chibaskogames.fr",
    "NEXT_PUBLIC_SUPABASE_URL": "https://oakjtjrzqkoiajmzbdlc.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_oxR8nmsY2eqq5sNsb_XoNw_-iWAXMNq",
    "RESEND_FROM_EMAIL": "noreply@chibaskogames.fr",
    "NEXT_PUBLIC_SITE_URL": "https://chibaskogames.fr"
  }
}
