{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "chibasko-games-preview",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-07",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [],
  "r2_buckets": [
    {
      "binding": "CHIBASKO_ASSETS",
      "bucket_name": "chibasko-assets"
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "CHIBASKO_CLOUDFLARE": "1",
    "NEXT_PUBLIC_SUPABASE_URL": "https://oakjtjrzqkoiajmzbdlc.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_oxR8nmsY2eqq5sNsb_XoNw_-iWAXMNq",
    "RESEND_FROM_EMAIL": "noreply@chibaskogames.fr",
    "NEXT_PUBLIC_SITE_URL": "https://chibaskogames.fr"
  }
}
