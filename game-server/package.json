{
  "name": "chibasko-game-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:sdk": "node ../scripts/build-game-sdk.mjs --server",
    "prebuild": "npm run build:sdk && npm run build:pong",
    "pretest": "npm run build:sdk && npm run build:pong && node ../games/chibasko-pong/scripts/build.mjs runtime",
    "predev": "npm run build:sdk && npm run build:pong",
    "dev": "node --env-file=.env.local --import tsx --watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "tsx --test tests/*.test.ts",
    "test:auth": "tsx --test tests/auth.test.ts",
    "build:pong": "npm --prefix ../games/chibasko-pong run build:server"
  },
  "dependencies": {
    "@chibaskogames/sdk": "file:../packages/game-sdk",
    "@colyseus/core": "0.18.18",
    "@colyseus/schema": "5.0.36",
    "@colyseus/ws-transport": "0.18.4",
    "@supabase/supabase-js": "2.104.0",
    "@chibaskogames/chibasko-pong": "file:../games/chibasko-pong"
  },
  "devDependencies": {
    "@colyseus/sdk": "0.18.5",
    "@types/express": "^5.0.6",
    "@types/node": "24.0.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
