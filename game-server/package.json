{
  "name": "chibasko-game-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file=.env.local --import tsx --watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "tsx --test tests/*.test.ts",
    "test:auth": "tsx --test tests/auth.test.ts"
  },
  "dependencies": {
    "@colyseus/core": "0.18.18",
    "@colyseus/schema": "5.0.36",
    "@colyseus/ws-transport": "0.18.4",
    "@supabase/supabase-js": "2.104.0"
  },
  "devDependencies": {
    "@colyseus/sdk": "0.18.5",
    "@types/node": "24.0.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
